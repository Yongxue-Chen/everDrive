{
  "name": "everdrive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "everDrive backend scaffold: local folder to multi-cloud sync and management.",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "demo:prepare": "npm run prisma:generate && npm run prisma:migrate:deploy && npm run seed",
    "demo:backend": "npm run demo:prepare && npm run dev"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "zod": "^3.25.17"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.18",
    "@types/supertest": "^6.0.3",
    "prisma": "^6.7.0",
    "supertest": "^7.1.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^2.1.9"
  }
}
