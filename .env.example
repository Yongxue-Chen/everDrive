# =========================================
# everDrive backend environment template
# =========================================

# Runtime
NODE_ENV=development
PORT=43107
LOG_LEVEL=info

# External MySQL (required)
# Format: mysql://user:password@host:3306/database
DATABASE_URL=mysql://everdrive:change_me@127.0.0.1:3306/everdrive

# rclone rcd (required)
# Keep rcd bound to localhost in production unless behind secure internal network.
RCLONE_RCD_URL=http://127.0.0.1:5572
# Docker backend should normally reach the Compose rclone service by service name.
DOCKER_RCLONE_RCD_URL=http://rclone:5572
RCLONE_RCD_USER=admin
RCLONE_RCD_PASS=change_me

# Encryption key (required in production when encryption feature is enabled)
ENCRYPTION_MASTER_KEY=change_me_to_a_long_random_secret

# rclone client behavior
RCLONE_HTTP_TIMEOUT_MS=5000
RCLONE_RETRY_ATTEMPTS=2
RCLONE_RETRY_DELAY_MS=250
LOCAL_PATH_ALLOWED_ROOTS=/

# Scan and schedule
SCAN_BATCH_SIZE=1000
# Scheduler interval (seconds): controls auto scan/rename-detect/sync cycle
SCAN_INTERVAL_SECONDS=30

# Sync and queue tuning
SYNC_CONCURRENCY=4
RCLONE_CONCURRENCY=4
JOB_WORKER_CONCURRENCY=2
JOB_SHORT_WORKER_CONCURRENCY=1
JOB_REMOTE_CONCURRENCY_LIMIT=1

# =========================================
# Docker compose optional overrides
# =========================================
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=everdrive
MYSQL_USER=everdrive
MYSQL_PASSWORD=everdrive_pass
DATA_ROOT=./data
DOCKER_LOCAL_PATH_ALLOWED_ROOTS=/data
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_PORT=3306
RCLONE_BIND_ADDRESS=127.0.0.1
RCLONE_RCD_PORT=5572
RCLONE_IMAGE=rclone/rclone:1.73.2
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=43107
FRONTEND_PORT=43117
VITE_DEFAULT_API_MODE=live
DB_MIGRATE_MAX_RETRIES=30
DB_MIGRATE_RETRY_DELAY_SECONDS=2
